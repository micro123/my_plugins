# Noctalia v5 Plugin Development — EditorConfig
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Luau entry scripts
[*.luau]
indent_style = space
indent_size = 2

# TOML manifests
[*.toml]
indent_style = space
indent_size = 2

# JSON (translations, data)
[*.json]
indent_style = space
indent_size = 2

# Python helper scripts
[*.py]
indent_style = space
indent_size = 4

# Markdown docs
[*.md]
indent_style = space
indent_size = 2
